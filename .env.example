# ============================================================================
# FISCAL — Environment Secrets Configuration Template
# Instructions: Copy this file to '.env' and insert your database credentials:
#   cp .env.example .env
# ============================================================================

# Cloud PostgreSQL JDBC Connection URL (Supabase IPv4 Pooler)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Database User
DB_USER=postgres.trqnooxyetnkufiblrkg

# Supabase Database Password (Keep secret! Do not commit to git)
DB_PASSWORD=your_supabase_password_here

# Application Port
PORT=8080

# Application Mode: AUTO (silent fallback when paused), LIVE (force database), MOCK (in-memory demo)
APP_MODE=AUTO
